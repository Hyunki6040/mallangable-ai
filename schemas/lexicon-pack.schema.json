{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mallangable.ai/schemas/v0.1/lexicon-pack.schema.json",
  "title": "Mallangable Lexicon Pack",
  "description": "Defines, per concept id, the wording by level (basic, practitioner, developer), domain and language. Experience-surface strings and the agent's user-facing answers go through this dictionary (spec 8.9).",
  "type": "object",
  "required": ["pack", "locale", "concepts"],
  "additionalProperties": false,
  "properties": {
    "pack": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "extends": { "type": "string", "description": "Id of the base pack to override (a domain pack extends the base pack)" },
        "domain": { "type": "string", "examples": ["general", "education", "healthcare", "enterprise"] }
      }
    },
    "locale": { "type": "string", "examples": ["ko", "en"] },
    "concepts": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/concept" }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basic_forbidden": { "type": "array", "items": { "type": "string" }, "description": "Words that must not appear in basic-level screens and answers" },
        "status_words": {
          "type": "object",
          "description": "Fixed status words for generation progress (spec 8.5)",
          "additionalProperties": false,
          "properties": {
            "understanding": { "type": "string" },
            "building": { "type": "string" },
            "checking": { "type": "string" },
            "ready": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "concept": {
      "type": "object",
      "required": ["basic"],
      "additionalProperties": false,
      "properties": {
        "basic": { "type": "string" },
        "practitioner": { "type": "string" },
        "developer": { "type": "string" },
        "explain": { "type": "string", "description": "One-line explanation at basic level" },
        "caution": { "type": "string", "description": "Warning text to append in sensitive domains" }
      }
    }
  }
}
