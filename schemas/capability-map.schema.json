{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mallangable.ai/schemas/v0.1/capability-map.schema.json",
  "title": "Mallangable Capability Map",
  "description": "Machine-readable list of the extension points, capabilities and state schemas a host exposes. Supplied to the agent as context (spec 2.2, 5.10).",
  "type": "object",
  "required": ["host", "map_version", "extension_points", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "host": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "version": { "type": "string", "description": "Host (core) version" }
      }
    },
    "map_version": { "type": "string", "description": "semver of the capability map itself" },
    "extension_points": {
      "type": "array",
      "items": { "$ref": "#/$defs/extensionPoint" }
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    },
    "catalog_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$",
      "description": "D3 catalog identifier. A URI-formatted string that need not be downloadable. The value changes whenever the catalog contents change (same meaning as A2UI catalogId)",
      "examples": ["https://todo.example/catalogs/v3"]
    },
    "catalog": {
      "type": "array",
      "description": "List of approved components usable in D3 declarative UI",
      "items": {
        "type": "object",
        "required": ["component"],
        "additionalProperties": false,
        "properties": {
          "component": { "type": "string" },
          "props_schema": { "type": "object" },
          "a11y": { "type": "string", "description": "Summary of accessibility requirements" }
        }
      }
    }
  },
  "$defs": {
    "depth": { "type": "string", "enum": ["D1", "D2", "D3", "D4", "D5"] },
    "extensionPoint": {
      "type": "object",
      "required": ["id", "kind", "d_min", "stability"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$", "examples": ["sidebar.panel", "task.on_complete"] },
        "kind": { "type": "string", "enum": ["token", "command", "view", "hook", "service"] },
        "d_min": { "$ref": "#/$defs/depth" },
        "d_max": { "$ref": "#/$defs/depth" },
        "version": { "type": "string" },
        "stability": { "type": "string", "enum": ["stable", "experimental", "deprecated"] },
        "deprecated_since": { "type": "string" },
        "replacement": { "type": "string" },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" },
        "merge": {
          "type": "object",
          "description": "Rules for merging this point's declarative artifacts across layers (spec 2.3, 6.6 R2). Keys are JSON Pointers into the artifact (RFC 6901; the empty string is the whole document). Value names follow x-kubernetes-list-type from Kubernetes Server-Side Apply. Arrays without a declaration are atomic",
          "propertyNames": { "pattern": "^(/([^~/]|~[01])*)*$" },
          "additionalProperties": { "$ref": "#/$defs/mergeRule" }
        },
        "description": { "type": "string" }
      }
    },
    "mergeRule": {
      "type": "object",
      "required": ["strategy"],
      "additionalProperties": false,
      "properties": {
        "strategy": { "type": "string", "enum": ["atomic", "set", "map"], "description": "atomic=replace as a whole, set=union of values, map=identify items by keys and merge item by item" },
        "keys": { "type": "array", "items": { "type": "string", "pattern": "\\S" }, "minItems": 1, "uniqueItems": true, "description": "Field names that identify items when strategy=map" }
      },
      "if": { "properties": { "strategy": { "const": "map" } } },
      "then": { "required": ["keys"] },
      "else": { "not": { "required": ["keys"] } }
    },
    "capability": {
      "type": "object",
      "required": ["id", "risk"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_*]+)+$", "examples": ["tasks.read", "net.slack.post"] },
        "risk": { "type": "string", "enum": ["read", "write", "egress", "sensitive"], "description": "egress=external transmission, sensitive=other people's or sensitive data. When a capability is exposed as an MCP tool, read is exported as readOnlyHint=true and egress as openWorldHint=true. Received MCP annotations are not trusted; this value is authoritative (I8)" },
        "destructive": { "type": "boolean", "default": false, "description": "Irreversible write. Same meaning as MCP destructiveHint. If true, G5 applies regardless of activation policy" },
        "lexicon_id": { "type": "string", "description": "Lexicon pack concept id used to look up the user-facing wording" },
        "description": { "type": "string" }
      },
      "if": { "properties": { "risk": { "const": "read" } } },
      "then": { "properties": { "destructive": { "const": false } } }
    }
  }
}
